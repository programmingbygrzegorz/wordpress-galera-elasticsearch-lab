# {{ ansible_managed }}
[mysqld]
bind-address             = 0.0.0.0
binlog_format            = ROW
default_storage_engine   = InnoDB
innodb_autoinc_lock_mode = 2
innodb_buffer_pool_size  = {{ galera_buffer_pool }}

[galera]
wsrep_on                 = ON
wsrep_provider           = /usr/lib/galera/libgalera_smm.so
wsrep_cluster_name       = {{ galera_cluster_name }}
# Wszystkie węzły klastra – węzeł startujący szuka pozostałych pod tymi adresami
wsrep_cluster_address    = gcomm://{% for n in cluster_nodes %}{{ lab_net }}.{{ lab_hosts[n] }}{{ ',' if not loop.last }}{% endfor %}

wsrep_node_name          = {{ inventory_hostname }}
wsrep_node_address       = {{ node_ip }}
# SST = pełna kopia danych dla nowego/zbyt starego węzła; IST = dosłanie brakujących zmian
wsrep_sst_method         = mariabackup
wsrep_sst_auth           = sst:{{ db_sst_password }}
wsrep_provider_options   = "gcache.size=256M"
