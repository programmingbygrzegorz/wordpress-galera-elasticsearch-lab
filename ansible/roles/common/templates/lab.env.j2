# {{ ansible_managed }}
# Wspólne ustawienia czytane przez skrypty labu (lab-status, lab-chaos, wp-release, wp-deploy)
LAB_NODE="{{ inventory_hostname }}"
LAB_NODE_IP="{{ node_ip }}"
LAB_LB_IP="{{ lb_ip }}"
LAB_DATA_IP="{{ data_ip }}"
WEB_NODES="{{ web_nodes | join(' ') }}"
WP_DOMAIN="{{ wp_domain }}"
WP_BASE="{{ wp_base }}"
WP_LOCALE="{{ wp_locale }}"
GIT_REPO_URL="{{ git_repo_url }}"
S3_BUCKET="{{ s3_bucket }}"
S3_PORT="{{ s3_port }}"
